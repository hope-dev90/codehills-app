// ============================================================
// UmucoCore — Prisma Schema
// Provider: postgresql (Supabase)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────

enum AuthProvider {
  password
  google
}

enum UserRole {
  user
  admin
}

enum ContactType {
  email
  phone
}

enum Language {
  en
  rw
  fr
}

enum ProductCategory {
  Handicrafts
  FoodAndDrinks
  Art
}

enum DestinationCategory {
  Nature
  Lakes
  Culture
  City
}

enum EventCategory {
  Festival
  Coffee
  Culture
}

enum OrderStatus {
  placed
  preparing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
}

enum PaymentMethod {
  cash_on_delivery
  mtn_momo
  airtel_money
  card
}

enum BusinessOrderStatus {
  New
  Preparing
  Delivered
}

// ──────────────────────────────────────────────────────────────
// AUTH / USERS
// ──────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  fullName     String
  contact      String       @unique
  contactType  ContactType
  passwordHash String?
  authProvider AuthProvider @default(password)
  role         UserRole     @default(user)
  googleId     String?      @unique
  googleEmail  String?
  language     Language     @default(en)
  rememberMe   Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  refreshTokens      RefreshToken[]
  favorites          UserFavorite[]
  bookmarks          UserBookmark[]
  savedPlaces        UserSavedPlace[]
  unlockedStories    UserUnlockedStory[]
  cartItems          CartItem[]
  orders             Order[]
  business           Business?

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────
// CULTURAL CONTENT
// ──────────────────────────────────────────────────────────────

model Story {
  id               String   @id
  title            String
  subtitle         String?
  category         String
  explorerCategory String?
  era              String?
  location         String?
  latitude         Float?
  longitude        Float?
  summary          String
  contentSummary   String?
  body             Json     // string[]
  tags             String[]
  gallery          String[]
  imageKey         String?
  imageUrl         String?
  relatedStoryIds  String[]
  xpReward         Int      @default(0)
  sourceNote       String?
  isDemo           Boolean  @default(false)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  products        Product[]
  orders          Order[]
  unlockedBy      UserUnlockedStory[]
  bookmarks       UserBookmark[]

  @@map("stories")
}

model Destination {
  id          String              @id
  name        String
  category    DestinationCategory
  summary     String
  description String
  latitude    Float
  longitude   Float
  imageKey    String?
  imageUrl    String?
  isDemo      Boolean             @default(false)
  isPublished Boolean             @default(true)
  createdAt   DateTime            @default(now())

  savedByUsers UserSavedPlace[]

  @@map("destinations")
}

model Event {
  id          String        @id @default(cuid())
  title       String
  category    EventCategory
  location    String
  dateLabel   String
  startsAt    DateTime?
  endsAt      DateTime?
  summary     String
  description String
  imageKey    String?
  imageUrl    String?
  isDemo      Boolean       @default(false)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@map("events")
}

// ──────────────────────────────────────────────────────────────
// MARKETPLACE
// ──────────────────────────────────────────────────────────────

model Artisan {
  id        String   @id @default(cuid())
  name      String
  location  String
  bio       String?
  imageUrl  String?
  createdAt DateTime @default(now())

  products Product[]

  @@map("artisans")
}

model Product {
  id               String          @id
  name             String
  slug             String          @unique
  shortDescription String
  description      String
  category         ProductCategory
  categoryId       String
  priceRwf         Int
  currency         String          @default("RWF")
  craftsmanship    String
  tags             String[]
  imageKey         String?
  imageUrl         String?
  gallery          String[]
  artisanId        String?
  sellerName       String
  rating           Float?
  reviewCount      Int             @default(0)
  rewardStoryId    String?
  isActive         Boolean         @default(true)
  isDemo           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  artisan       Artisan?         @relation(fields: [artisanId], references: [id])
  rewardStory   Story?           @relation(fields: [rewardStoryId], references: [id])
  orderLines    OrderLine[]
  cartItems     CartItem[]
  favoritedBy   UserFavorite[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

// ──────────────────────────────────────────────────────────────
// SHOPPING
// ──────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id                 String        @id
  userId             String?
  subtotalRwf        Int
  shippingRwf        Int
  totalRwf           Int
  currency           String        @default("RWF")
  deliveryFullName   String
  deliveryPhone      String
  deliveryAddress    String
  deliveryCity       String
  status             OrderStatus   @default(placed)
  paymentStatus      PaymentStatus @default(unpaid)
  paymentMethod      PaymentMethod @default(cash_on_delivery)
  rewardStoryId      String?
  isDemo             Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user            User?               @relation(fields: [userId], references: [id])
  rewardStory     Story?              @relation(fields: [rewardStoryId], references: [id])
  lines           OrderLine[]
  unlockedStories UserUnlockedStory[]

  @@index([userId])
  @@map("orders")
}

model OrderLine {
  id            String @id @default(cuid())
  orderId       String
  productId     String?
  productName   String
  priceRwf      Int
  quantity      Int
  imageKey      String?
  imageUrl      String?
  rewardStoryId String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

// ──────────────────────────────────────────────────────────────
// USER COLLECTIONS
// ──────────────────────────────────────────────────────────────

model UserFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@map("user_favorites")
}

model UserBookmark {
  userId    String
  storyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id])

  @@id([userId, storyId])
  @@map("user_bookmarks")
}

model UserSavedPlace {
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@id([userId, destinationId])
  @@map("user_saved_places")
}

model UserUnlockedStory {
  userId     String
  storyId    String
  orderId    String?
  unlockedAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story  @relation(fields: [storyId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@id([userId, storyId])
  @@map("user_unlocked_stories")
}

// ──────────────────────────────────────────────────────────────
// BUSINESS TOOLS
// ──────────────────────────────────────────────────────────────

model Business {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  category    String
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         BusinessProduct[]
  orders           BusinessOrder[]
  plans            BusinessPlan[]

  @@map("businesses")
}

model BusinessProduct {
  id         String   @id @default(cuid())
  businessId String
  name       String
  priceRwf   Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_products")
}

model BusinessOrder {
  id              String              @id @default(cuid())
  businessId      String
  orderId         String?
  customerName    String
  itemDescription String
  totalRwf        Int
  status          BusinessOrderStatus @default(New)
  createdAt       DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_orders")
}

model BusinessPlan {
  id          String   @id @default(cuid())
  businessId  String
  content     Json     // full BusinessPlan object
  generatedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_plans")
}

// ──────────────────────────────────────────────────────────────
// LEARNING
// ──────────────────────────────────────────────────────────────

model LearningResource {
  id          String   @id
  title       String
  summary     String
  body        Json     // string[]
  sortOrder   Int      @default(0)
  isDemo      Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("learning_resources")
}
