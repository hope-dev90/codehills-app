# ─── UmucoCore backend ───────────────────────────────────────────────────────
# Required: point at the running backend.
# Local:  http://localhost:4000/api
# Device: http://<your-machine-LAN-IP>:4000/api  (for Expo Go on a physical device)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Obtain all three client IDs from Google Cloud Console → APIs & Services → Credentials
# Leave empty to disable Google sign-in (email/phone login still works).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# ─── Gemini direct (optional) ─────────────────────────────────────────────────
# The backend already calls Gemini server-side for business plan generation.
# Set this only if you also want the mobile app to call Gemini directly.
EXPO_PUBLIC_GEMINI_API_KEY=

# ─── NEVER put these in this file ─────────────────────────────────────────────
# DATABASE_URL, DIRECT_URL, SUPABASE_SERVICE_ROLE_KEY,
# JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, GEMINI_API_KEY (server), payment secrets
# → those belong in umucocore-backend/backend/.env only
